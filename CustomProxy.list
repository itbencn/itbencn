# 自定义代理列(长期代理)


# PROCESS-NAME,curl #匹配路由自身进程(curl直连)
# DOMAIN-SUFFIX,google.com #匹配域名后缀(交由Proxy代理服务器组)
# DOMAIN-KEYWORD,google #匹配域名关键字(交由Proxy代理服务器组)
# DOMAIN,google.com #匹配域名(交由Proxy代理服务器组)
# DOMAIN-SUFFIX,ad.com #匹配域名后缀(拒绝)
# IP-CIDR,127.0.0.0/8 #匹配数据目标IP(直连)
# SRC-IP-CIDR,192.168.1.201/32 #匹配数据发起IP(直连)
# DST-PORT,80 #匹配数据目标端口(直连)
# SRC-PORT,7777 #匹配数据源端口(直连)
# GEOSITE,category-public-tracker #匹配GEOSITE数据库规则(直连)
# DOMAIN-REGEX,^abc.*com #正则匹配域名
# RULE-SET,providername #匹配规则集


